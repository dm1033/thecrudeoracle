# ============================================================================
# The Crude Oracle — environment variables
# ----------------------------------------------------------------------------
# Copy to .env.local for local dev, or set in Vercel/Netlify dashboard.
# NEVER commit .env.local or real keys to git (.gitignore already excludes it).
# NEVER put secret keys in frontend code or NEXT_PUBLIC_* variables.
# ============================================================================

# --- Payments: RETIRED ------------------------------------------------------
# The Crude Oracle is now 100% free. The paid subscription and the Stripe
# integration (webhook, billing portal, checkout, Payment Link) have been
# removed from the codebase — there are no Stripe environment variables to
# set. See README_DEPLOYMENT.md for details.

# --- Auth placeholder (Phase 2: Supabase) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only

# --- Market data API placeholders (Phase 3) ----------------------------------
ALPHA_VANTAGE_API_KEY=replace_me
POLYGON_API_KEY=replace_me
NASDAQ_DATA_LINK_API_KEY=replace_me

# --- EIA Open Data API (free, public domain, no licence restriction) --------
# Powers src/lib/eia.ts and scripts/update-eia-data.mjs — automated WTI/Brent
# spot prices and US commercial/Cushing crude stock levels, replacing the
# hand-typed entries for those specific fields in data/market-prices.json and
# data/balance-engine.json. Get a free key (instant, no approval wait) at:
#   https://www.eia.gov/opendata/register.php
# Server-side only — never expose this as a NEXT_PUBLIC_* variable.
# EIA_API is accepted when EIA_API_KEY is unset. Surrounding quotes and
# whitespace are ignored. See docs/EIA_INTEGRATION.md.
EIA_API_KEY=replace_me

# --- Google Search Console (HTML tag, no DNS change) -------------------------
# Search Console → Add property → URL prefix https://www.thecrudeoracle.com
# → HTML tag. Paste the content token (or the whole meta tag). Leave this
# blank to omit the tag. Set it in Vercel and redeploy. Never commit a real token.
GOOGLE_SITE_VERIFICATION=

# --- The Daily Bottom Line (email signup) ------------------------------------
# The homepage offers "Free weekday morning oil brief". Set all three for the
# on-site form. If BEEHIIV_API_KEY or BEEHIIV_PUBLICATION_ID is missing, the
# box links to the public beehiiv subscribe page and does not error.
#   NEWSLETTER_PROVIDER=beehiiv
#   BEEHIIV_API_KEY=           # beehiiv Settings → API
#   BEEHIIV_PUBLICATION_ID=    # publication id, pub_...
# or, instead of beehiiv:
#   NEWSLETTER_PROVIDER=buttondown
#   BUTTONDOWN_API_KEY=        # Buttondown settings → API
# Server-side only. Never prefix these with NEXT_PUBLIC_.
NEWSLETTER_PROVIDER=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BUTTONDOWN_API_KEY=

# --- Sponsorship enquiry form (optional) -------------------------------------
# Free Web3Forms access key: https://web3forms.com
# David: create a key, verify it to intelligence@thecrudeoracle.com, and set
# SPONSOR_ENQUIRY_ACCESS_KEY in the Vercel project (Production and Preview).
# Server-side only. Never prefix it with NEXT_PUBLIC_ and never commit a real key.
# Leave it blank to keep the enquiry form and fall back to the visitor's email app.
SPONSOR_ENQUIRY_ACCESS_KEY=

# --- Morning note revalidation (optional) ------------------------------------
# Vercel Cron calls /api/revalidate-daily around 07:00 Europe/London.
# When CRON_SECRET is set, Vercel sends Authorization: Bearer <CRON_SECRET>
# and the route rejects other callers. Leave it blank to build and run
# without a new secret. Never commit a real value.
CRON_SECRET=
