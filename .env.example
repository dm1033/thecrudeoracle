# ============================================================================
# The Crude Oracle — environment variables
# ----------------------------------------------------------------------------
# Copy to .env.local for local dev, or set in Vercel/Netlify dashboard.
# NEVER commit .env.local or real keys to git (.gitignore already excludes it).
# NEVER put secret keys in frontend code or NEXT_PUBLIC_* variables.
# ============================================================================

# --- Payments: RETIRED ------------------------------------------------------
# The Crude Oracle is now 100% free. The paid subscription and the Stripe
# integration (webhook, billing portal, checkout, Payment Link) have been
# removed from the codebase — there are no Stripe environment variables to
# set. See README_DEPLOYMENT.md for details.

# --- Auth placeholder (Phase 2: Supabase) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only

# --- Market data API placeholders (Phase 3) ----------------------------------
ALPHA_VANTAGE_API_KEY=replace_me
POLYGON_API_KEY=replace_me
NASDAQ_DATA_LINK_API_KEY=replace_me

# --- EIA Open Data API (free, public domain, no licence restriction) --------
# Powers src/lib/eia.ts and scripts/update-eia-data.mjs — automated WTI/Brent
# spot prices and US commercial/Cushing crude stock levels, replacing the
# hand-typed entries for those specific fields in data/market-prices.json and
# data/balance-engine.json. Get a free key (instant, no approval wait) at:
#   https://www.eia.gov/opendata/register.php
# Server-side only — never expose this as a NEXT_PUBLIC_* variable.
# See docs/EIA_INTEGRATION.md for setup, what it updates, and what still
# needs live verification on first production run (this repo's sandbox has
# no outbound internet access, so the integration could not be tested
# against the real api.eia.gov).
EIA_API_KEY=replace_me

# --- The Daily Bottom Line (email signup) ------------------------------------
# Leave NEWSLETTER_PROVIDER blank until a list exists. The homepage and
# /daily-briefing forms then tell visitors to email the desk. Set one provider:
#   NEWSLETTER_PROVIDER=beehiiv
#   BEEHIIV_API_KEY=           # beehiiv Settings → API
#   BEEHIIV_PUBLICATION_ID=    # publication id, pub_...
# or:
#   NEWSLETTER_PROVIDER=buttondown
#   BUTTONDOWN_API_KEY=        # Buttondown settings → API
# Server-side only. Never prefix these with NEXT_PUBLIC_.
NEWSLETTER_PROVIDER=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BUTTONDOWN_API_KEY=
