# ============================================================================
# The Crude Oracle Desk Agent (CODA) — environment template
# ----------------------------------------------------------------------------
# Copy to secrets/.env  (mode 0600). NEVER commit secrets/.env.
# NEVER put a real key in this file. NEVER use NEXT_PUBLIC_* or VITE_* for
# secrets. The public site (www.thecrudeoracle.com) is Vercel; this agent
# binds 127.0.0.1:8787 and writes to the site only via GitHub PR → preview.
# ============================================================================

# --- Required ---------------------------------------------------------------
# xAI / Grok — desk drafts, prompt scoring, news-to-barrels.
# When XAI_API_KEY is unset or left as replace_me, CODA runs a deterministic
# offline draft generator instead of calling the API (dry-run still works).
XAI_API_KEY=replace_me
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-4

# GitHub fine-grained PAT. Scope: contents:write + pull_requests on
#   dm1033/thecrudeoracle
#   dm1033/thecrudeoracle-desk
# Expiry ≤ 90 days. No delete-repo. No workflow admin. No org-wide.
GITHUB_TOKEN=replace_me
GITHUB_OWNER=dm1033
GITHUB_SITE_REPO=thecrudeoracle
GITHUB_DESK_REPO=thecrudeoracle-desk

# EIA Open Data (free, public domain). Instant key:
#   https://www.eia.gov/opendata/register.php
# Server-side only. Powers scripts/update-eia-data.mjs in the site repo.
EIA_API_KEY=replace_me

# Console token for http://127.0.0.1:8787
# install.sh generates one with `openssl rand -hex 32` if missing.
# Health endpoints never echo this value.
AGENT_CONSOLE_TOKEN=replace_me

# --- Bind / network ---------------------------------------------------------
# Loopback only. Do not set 0.0.0.0. Public bind requires
# OPERATOR_BIND=public AND Caddy basic-auth (see network/Caddyfile).
CODA_HOST=127.0.0.1
CODA_PORT=8787
OPERATOR_BIND=loopback

# --- Paths ------------------------------------------------------------------
# Site checkout used for dry-run patches. install.sh --with-repos clones both.
SITE_REPO_DIR=./repos/thecrudeoracle
DESK_REPO_DIR=./repos/thecrudeoracle-desk
OUTBOX_DIR=./outbox
PROMPT_DIR=./prompts
ALLOWLIST_FILE=./network/allowlist.txt

# --- Cycle defaults ---------------------------------------------------------
# dry-run = write outbox + local branch, never open a PR.
# --publish on start.sh opens a PR against a coda/* branch. Human merges.
CODA_MODE=dry-run
CODA_TIMEZONE=Europe/London
CODA_LOG_LEVEL=info

# --- Optional delayed / indicative feeds (never treat as licensed tape) -----
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
NASDAQ_DATA_LINK_API_KEY=

# Phase 2 auth on the public site (optional; agent does not need these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Forbidden (do not set) -------------------------------------------------
# STRIPE_*                         — paid tier retired
# CME_ / ICE_ / ARGUS_ / PLATTS_   — no licensed PRA / exchange tokens
# BLOOMBERG_* / REUTERS_*          — do not paste paid prints
# BROKER_* / EXCHANGE_ORDER_*      — no auto-trade
# NEXT_PUBLIC_XAI_API_KEY          — never
# VITE_XAI_API_KEY                 — never
